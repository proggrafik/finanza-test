# Conexión directa (desarrollo local)
DATABASE_URL=postgresql://postgres:TU-CONTRASEÑA@db.TU-REFERENCIA.supabase.co:5432/postgres

# Conexión con pool (recomendada para Vercel)
# SUABASE_DB_URL=postgresql://postgres:TU-CONTRASEÑA@db.TU-REFERENCIA.pooler.supabase.com:6543/postgres

# Variables públicas (opcional, para Supabase client)
# NEXT_PUBLIC_SUPABASE_URL=https://TU-REFERENCIA.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY
# SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY
